---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "./Icon.astro";
import { siteContent, type SiteLocale } from "../data/siteContent";
import { localizedRoute } from "../utils/routes";

const { locale } = Astro.props as { locale: SiteLocale };
const copy = siteContent[locale].research;
---

<BaseLayout title={copy.title} description={copy.description} locale={locale} preloadSerif>
  <section class="page-hero research-hero">
    <div class="container page-hero-inner">
      <h1>{copy.title}</h1>
      <p class="page-lead">{copy.description}</p>
      <div class="actions">
        <a class="button button-primary" href={localizedRoute("writings", locale)}>{copy.writingCta}<Icon name="chevron.right" /></a>
        <a class="text-link" href={localizedRoute("cv", locale)}>{copy.cvCta}<Icon name="chevron.right" /></a>
      </div>
    </div>
  </section>

  <section class="narrative-band">
    <div class="container-wide">
      <header class="narrative-band__header">
        <div><h2>{copy.areasTitle}</h2></div>
        <p>{copy.areasIntro}</p>
      </header>
      <div class="narrative-rows">
        {copy.areas.map((area, index) => (
          <article class="narrative-row">
            <span class="narrative-row__number">{String(index + 1).padStart(2, "0")}</span>
            <h3>{area.title}</h3>
            <p>{area.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-muted">
    <div class="container-wide split-heading-layout">
      <header>
        <h2>{copy.questionsTitle}</h2>
        <p class="section-heading">{copy.questionsIntro}</p>
      </header>
      <ol class="question-list">
        {copy.questions.map((question) => <li>{question}</li>)}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container-wide related-panel">
      <div>
        <h2>{copy.relatedTitle}</h2>
        <p>{copy.relatedDescription}</p>
      </div>
      <div class="actions">
        <a class="text-link" href={localizedRoute("writings", locale)}>{copy.writingCta}<Icon name="chevron.right" /></a>
        <a class="text-link" href={localizedRoute("resources", locale)}>{copy.resourcesCta}<Icon name="chevron.right" /></a>
      </div>
    </div>
  </section>
</BaseLayout>
