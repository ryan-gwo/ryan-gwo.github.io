---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "./Icon.astro";
import { siteContent, type SiteLocale } from "../data/siteContent";
import { localizedRoute } from "../utils/routes";

const { locale } = Astro.props as { locale: SiteLocale };
const copy = siteContent[locale].interests;
const routeForCard = (href?: string) => {
  if (!href) return undefined;
  if (href.includes("/writings/")) return localizedRoute("writings", locale);
  if (href.includes("/resources/")) return localizedRoute("resources", locale);
  return href;
};
---

<BaseLayout title={copy.title} description={copy.description} locale={locale} preloadSerif>
  <section class="page-hero">
    <div class="container page-hero-inner">
      <h1>{copy.title}</h1>
      <p class="page-lead">{copy.description}</p>
    </div>
  </section>
  <section class="section section-muted">
    <div class="container-wide">
      <header class="narrative-band__header">
        <div><h2>{copy.sectionTitle}</h2></div>
        <p>{copy.sectionIntro}</p>
      </header>
      <div class="narrative-rows">
        {copy.cards.map((card, index) => (
          <article class="narrative-row">
            <span class="narrative-row__number">{String(index + 1).padStart(2, "0")}</span>
            <div>
              <h3>{card.title}</h3>
            </div>
            <div>
              <p>{card.description}</p>
              {routeForCard(card.href) && <a class="text-link" href={routeForCard(card.href)}>{card.cta}<Icon name="chevron.right" /></a>}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
