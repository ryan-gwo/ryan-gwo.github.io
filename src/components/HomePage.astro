---
import { Picture } from "astro:assets";
import Icon from "./Icon.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteContent, type SiteLocale } from "../data/siteContent";
import { localizedRoute } from "../utils/routes";
import heroImage from "../assets/PIA21474.jpg";

const { locale } = Astro.props as { locale: SiteLocale };
const copy = siteContent[locale];
const home = copy.home;
const writing = copy.writings;
const route = (name: "research" | "cv" | "writings" | "resources" | "interests") => localizedRoute(name, locale);
---

<BaseLayout title={copy.meta.title} description={copy.meta.description} locale={locale} preloadSerif>
  <section class="hero-scene">
    <Picture
      class="hero-scene__media"
      src={heroImage}
      widths={[640, 960, 1280]}
      sizes="100vw"
      formats={["avif", "webp"]}
      alt={home.heroVisualAlt}
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero-scene__scrim" aria-hidden="true"></div>
    <div class="hero-scene__content">
      <h1>{home.name}</h1>
      <p class="hero-role">{home.role}</p>
      <p class="hero-focus">{home.focus}</p>
      <div class="hero-cta-row">
        <a class="button button-primary" href={route("research")}>{home.researchCta}<Icon name="chevron.right" /></a>
        <a class="text-link" href={route("cv")}>{home.cvCta}<Icon name="chevron.right" /></a>
      </div>
    </div>
    <p class="hero-scene__credit">NASA/ESA et al. · <a href="https://images.nasa.gov/details/PIA21474" target="_blank" rel="noreferrer">Crab Nebula composite</a></p>
  </section>

  <section class="section section-muted">
    <div class="container-wide">
      <div class="data-strip" aria-label={home.currentTitle}>
        {home.currentItems.map((item) => (
          <div class="data-point">
            <strong>{item.label}</strong>
            <span>{item.value}</span>
          </div>
        ))}
        <div class="data-point">
          <strong>2026</strong>
          <span>{locale === "en" ? "PhD at Peking University" : locale === "zh-cn" ? "北京大学博士阶段" : "北京大學博士階段"}</span>
        </div>
        <div class="data-point">
          <strong>GW</strong>
          <span>{locale === "en" ? "Gravitational-wave astronomy" : locale === "zh-cn" ? "引力波天文学" : "引力波天文學"}</span>
        </div>
      </div>
    </div>
  </section>

  <section class="narrative-band narrative-band--dark">
    <div class="container-wide">
      <header class="narrative-band__header">
        <div>
          <h2>{home.researchTitle}</h2>
        </div>
        <p>{home.researchIntro}</p>
      </header>
      <div class="narrative-rows">
        {home.researchCards.map((card, index) => (
          <article class="narrative-row">
            <span class="narrative-row__number">{String(index + 1).padStart(2, "0")}</span>
            <h3>{card.title}</h3>
            <p>{card.description}</p>
          </article>
        ))}
      </div>
      <a class="text-link" href={route("research")}>{home.researchCta}<Icon name="chevron.right" /></a>
    </div>
  </section>

  <section class="section">
    <div class="container-wide profile-layout">
      <div class="profile-copy">
        <h2>{home.profileTitle}</h2>
        {home.profileParagraphs.map((paragraph) => <p>{paragraph}</p>)}
        <p class="profile-fact">{home.portraitCaption}</p>
        <a class="text-link" href={route("cv")}>{home.cvCta}<Icon name="chevron.right" /></a>
      </div>
      <aside class="profile-aside">
        <div class="current-panel">
          <h3>{home.currentTitle}</h3>
          {home.currentItems.map((item) => <div class="current-item"><span>{item.label}</span><p>{item.value}</p></div>)}
        </div>
      </aside>
    </div>
  </section>

  <section class="section section-muted">
    <div class="container-wide">
      <header class="section-heading">
        <h2>{home.writingTitle}</h2>
        <p>{home.writingIntro}</p>
      </header>
      <div class="flat-index">
        <article class="flat-row">
          <div class="flat-row__meta">{writing.articleMeta}</div>
          <div>
            <h3>{writing.articleTitle}</h3>
            <p>{writing.articleSummary}</p>
          </div>
          <a href={route("writings")} class="text-link">{home.writingCta}<Icon name="chevron.right" /></a>
        </article>
      </div>
    </div>
  </section>

  <section class="section section-black">
    <div class="container-wide">
      <header class="section-heading">
        <h2>{home.resourcesTitle}</h2>
        <p>{home.resourcesDescription}</p>
      </header>
      <a class="text-link" href={route("resources")}>{home.resourcesLink}<Icon name="chevron.right" /></a>
    </div>
  </section>

  <section class="section">
    <div class="container-wide">
      <header class="section-heading">
        <h2>{home.beyondTitle}</h2>
        <p>{home.beyondIntro}</p>
      </header>
      <div class="quiet-grid">
        {home.beyondCards.map((card) => <article><h3>{card.title}</h3><p>{card.description}</p></article>)}
      </div>
      <a class="text-link section-cta" href={route("interests")}>{copy.navigation.interests}<Icon name="chevron.right" /></a>
    </div>
  </section>
</BaseLayout>
