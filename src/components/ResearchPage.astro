---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from './Icon.astro';
import { localizedPath, siteContent, type SiteLocale } from '../data/siteContent';
const { locale } = Astro.props as { locale: SiteLocale };
const site = siteContent[locale];
const copy = site.research;
---
<BaseLayout title={copy.title} description={copy.description} locale={locale} preloadSerif>
  <section class="page-hero research-hero section-dark">
    <div class="container page-hero-inner">
      <h1>{copy.title}</h1>
      <p class="page-lead">{copy.description}</p>
      <div class="actions">
        <a class="button button-primary" href={localizedPath(locale, '/writings/')}>{copy.writingCta}</a>
        <a class="button button-link button-link-dark" href={localizedPath(locale, '/cv/')}>{copy.cvCta}<Icon name="chevron.right" /></a>
      </div>
    </div>
  </section>
  <section class="content-section section-soft">
    <div class="container">
      <header class="section-heading"><h2 class="section-title">{copy.areasTitle}</h2><p class="section-intro">{copy.areasIntro}</p></header>
      <div class="editorial-grid">
        {copy.areas.map((area) => <article class="editorial-card"><h3>{area.title}</h3><p>{area.description}</p></article>)}
      </div>
    </div>
  </section>
  <section class="content-section questions-section">
    <div class="container split-heading-layout">
      <header><h2 class="section-title">{copy.questionsTitle}</h2><p class="section-intro">{copy.questionsIntro}</p></header>
      <ul class="question-list">{copy.questions.map((question) => <li>{question}</li>)}</ul>
    </div>
  </section>
  <section class="content-section section-soft related-panel-section">
    <div class="container related-panel">
      <div><h2>{copy.relatedTitle}</h2><p>{copy.relatedDescription}</p></div>
      <div class="actions"><a class="text-link" href={localizedPath(locale, '/writings/')}>{copy.writingCta}<Icon name="chevron.right" /></a><a class="text-link" href={localizedPath(locale, '/resources/')}>{copy.resourcesCta}<Icon name="chevron.right" /></a></div>
    </div>
  </section>
</BaseLayout>
