---
import Icon from "./Icon.astro";
import { competitionResources, getCompetitionBasePath, getEditionPath, type ResourceLocale } from "../data/competitionResources";
import { localizedRoute, type SiteLocale } from "../utils/routes";

const { locale = "en" } = Astro.props as { locale?: SiteLocale };
const copy = {
  en: { placeholder: "Search pages, writing, and resources", empty: "No results found.", close: "Close search", page: "Page", resource: "Resource" },
  "zh-cn": { placeholder: "搜索页面、写作与资源", empty: "没有找到结果。", close: "关闭搜索", page: "页面", resource: "资源" },
  "zh-hk": { placeholder: "搜尋頁面、寫作與資源", empty: "未找到結果。", close: "關閉搜尋", page: "頁面", resource: "資源" },
}[locale];

const routeEntries = [
  { route: "home" as const, title: { en: "Home", "zh-cn": "首页", "zh-hk": "首頁" }[locale], description: { en: "Academic homepage and overview.", "zh-cn": "学术主页与概览。", "zh-hk": "學術主頁與概覽。" }[locale], kind: copy.page },
  { route: "research" as const, title: { en: "Research", "zh-cn": "研究", "zh-hk": "研究" }[locale], description: { en: "Research directions and current focus.", "zh-cn": "研究方向与当前关注问题。", "zh-hk": "研究方向與當前關注問題。" }[locale], kind: copy.page },
  { route: "writings" as const, title: { en: "Selected Writing", "zh-cn": "精选写作", "zh-hk": "精選寫作" }[locale], description: { en: "Curated notes and essays.", "zh-cn": "精选笔记与文章。", "zh-hk": "精選筆記與文章。" }[locale], kind: copy.page },
  { route: "cv" as const, title: { en: "CV", "zh-cn": "简历", "zh-hk": "履歷" }[locale], description: { en: "Curriculum Vitae and background.", "zh-cn": "个人履历与经历。", "zh-hk": "個人履歷與經歷。" }[locale], kind: copy.page },
  { route: "interests" as const, title: { en: "Interests", "zh-cn": "兴趣", "zh-hk": "興趣" }[locale], description: { en: "Reading, observing, and life beyond research.", "zh-cn": "研究之外的阅读、观测与日常。", "zh-hk": "研究之外的閱讀、觀測與日常。" }[locale], kind: copy.page },
  { route: "resources" as const, title: { en: "Resources", "zh-cn": "资源库", "zh-hk": "資源庫" }[locale], description: { en: "Astronomy competition archive.", "zh-cn": "天文竞赛资料归档。", "zh-hk": "天文競賽資料歸檔。" }[locale], kind: copy.resource },
].map((entry) => ({ ...entry, href: localizedRoute(entry.route, locale), keywords: `${entry.title} ${entry.description}` }));

const competitionEntries = Object.values(competitionResources[locale as ResourceLocale] ?? {}).flatMap((competition) => [
  {
    href: getCompetitionBasePath(locale as ResourceLocale, competition.slug),
    title: competition.title,
    description: competition.description,
    kind: copy.resource,
    keywords: `${competition.title} ${competition.description} ${competition.slug}`,
  },
  ...competition.editions.map((edition) => ({
    href: getEditionPath(locale as ResourceLocale, competition.slug, edition),
    title: edition.label,
    description: edition.summary ?? competition.description,
    kind: copy.resource,
    keywords: [competition.title, edition.label, edition.date, edition.location, edition.summary].filter(Boolean).join(" "),
  })),
]);

const fallbackEntries = [...routeEntries, ...competitionEntries];
---

<dialog class="search-overlay" id="site-search-overlay" aria-labelledby="site-search-title" data-search-locale={locale}>
  <section class="search-panel">
    <div class="search-panel__content">
      <div class="search-panel__header">
        <h2 id="site-search-title">{copy.placeholder}</h2>
        <button class="search-close" type="button" data-search-close aria-label={copy.close}>×</button>
      </div>
      <label class="search-field" for="site-search-input">
        <span class="search-field__icon" aria-hidden="true"><Icon name="search" /></span>
        <input id="site-search-input" class="search-field__input" type="search" autocomplete="off" spellcheck="false" placeholder={copy.placeholder} aria-label={copy.placeholder} />
      </label>
      <div class="search-panel__results-shell" aria-live="polite">
        <p class="search-panel__empty" data-search-empty hidden>{copy.empty}</p>
        <ul class="search-results" data-search-results></ul>
      </div>
    </div>
  </section>
</dialog>

<script is:inline define:vars={{ fallbackEntries, copy }}>
  (() => {
    const overlay = document.getElementById("site-search-overlay");
    const input = document.getElementById("site-search-input");
    const results = overlay?.querySelector("[data-search-results]");
    const empty = overlay?.querySelector("[data-search-empty]");
    const openers = Array.from(document.querySelectorAll("[data-search-open]"));
    const closers = Array.from(document.querySelectorAll("[data-search-close]"));
    if (!overlay || !input || !results || !empty || openers.length === 0) return;

    let previousFocus = null;
    let pagefind = null;
    let resultLinks = [];
    let activeIndex = 0;

    const normalize = (value) => value.toString().toLowerCase().normalize("NFKD").replace(/[\u0300-\u036f]/g, "");
    const render = (entries) => {
      results.innerHTML = entries.map((entry) => `
        <li class="search-results__item">
          <a class="search-results__link" href="${entry.href}">
            <span class="search-results__title">${entry.title}</span>
            <span class="search-results__description">${entry.description ?? ""}</span>
            <span class="search-results__meta"><span>${entry.kind ?? copy.page}</span><span>${entry.href}</span></span>
          </a>
        </li>
      `).join("");
      resultLinks = Array.from(results.querySelectorAll("a"));
      activeIndex = 0;
      resultLinks[0]?.classList.add("is-active");
      empty.hidden = entries.length > 0;
    };

    const fallbackSearch = (query) => {
      const tokens = normalize(query).split(/\s+/).filter(Boolean);
      const entries = fallbackEntries.filter((entry) => tokens.length === 0 || tokens.every((token) => normalize(`${entry.title} ${entry.description} ${entry.keywords}`).includes(token)));
      render(entries.slice(0, 24));
    };

    const loadPagefind = async () => {
      if (pagefind !== null) return pagefind;
      try {
        pagefind = await import("/pagefind/pagefind.js");
        await pagefind.options({ excerptLength: 18 });
        return pagefind;
      } catch {
        pagefind = false;
        return null;
      }
    };

    const search = async () => {
      const query = input.value.trim();
      const index = await loadPagefind();
      if (!index || !query) {
        fallbackSearch(query);
        return;
      }
      const searchResult = await index.search(query, { filters: { language: overlay.dataset.searchLocale } });
      const entries = await Promise.all(searchResult.results.slice(0, 24).map(async (result) => {
        const data = await result.data();
        return { href: data.url, title: data.meta?.title ?? data.url, description: data.excerpt ?? "", kind: copy.page };
      }));
      render(entries);
    };

    const setOpen = (open) => {
      if (open) {
        previousFocus = document.activeElement;
        if (!overlay.open) overlay.showModal();
        document.body.classList.add("search-overlay-open");
        input.focus({ preventScroll: true });
        input.select();
        search();
      } else {
        if (overlay.open) overlay.close();
        document.body.classList.remove("search-overlay-open");
        if (previousFocus instanceof HTMLElement) previousFocus.focus({ preventScroll: true });
      }
    };

    openers.forEach((button) => button.addEventListener("click", () => setOpen(true)));
    closers.forEach((button) => button.addEventListener("click", () => setOpen(false)));
    overlay.addEventListener("cancel", (event) => {
      event.preventDefault();
      setOpen(false);
    });
    overlay.addEventListener("click", (event) => {
      if (event.target === overlay) setOpen(false);
    });
    input.addEventListener("input", search);
    input.addEventListener("keydown", (event) => {
      if (event.key === "Escape") setOpen(false);
      if (event.key === "ArrowDown" && resultLinks.length) {
        event.preventDefault();
        resultLinks[activeIndex]?.classList.remove("is-active");
        activeIndex = (activeIndex + 1) % resultLinks.length;
        resultLinks[activeIndex]?.classList.add("is-active");
      }
      if (event.key === "ArrowUp" && resultLinks.length) {
        event.preventDefault();
        resultLinks[activeIndex]?.classList.remove("is-active");
        activeIndex = (activeIndex - 1 + resultLinks.length) % resultLinks.length;
        resultLinks[activeIndex]?.classList.add("is-active");
      }
      if (event.key === "Enter") resultLinks[activeIndex]?.click();
    });
    window.addEventListener("keydown", (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
        event.preventDefault();
        setOpen(true);
      }
      if (event.key === "Escape" && overlay.open) setOpen(false);
    });
    fallbackSearch("");
  })();
</script>
